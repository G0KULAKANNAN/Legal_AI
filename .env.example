# ==========================================
# LegalAI Environment Configuration Example
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# For local development with Docker:
DATABASE_URL=postgresql://legalai:legalai_password@localhost:5432/legalai_db?schema=public
DIRECT_URL=postgresql://legalai:legalai_password@localhost:5432/legalai_db?schema=public

# Redis Configuration (BullMQ Background Jobs & Rate Limiting)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security & Sessions
SESSION_SECRET=super_secret_session_key_change_in_production

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Storage Configuration
# Options: local | supabase
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# Supabase Storage (Optional - if STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=legalai-documents

# OCR Language Data Path (Optional - Tesseract will auto-download if unconfigured)
TESSDATA_PREFIX=

# Admin Initial Credentials (Used during db seed)
ADMIN_INITIAL_EMAIL=admin@legalai.com
ADMIN_INITIAL_PASSWORD=AdminPass123!LegalAI
