{
  "version": 2,
  "buildCommand": "prisma generate && tsc",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
